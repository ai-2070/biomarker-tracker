{
  "name": "biomarker-tracker",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build typecheck typecheck:tests",
    "eve:build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=@bt/eve",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.json",
    "preview": "bun run --cwd apps/web preview",
    "server": "bun apps/server/index.ts",
    "start": "bun run build && bun apps/server/index.ts",
    "tauri": "bun run --cwd apps/desktop tauri",
    "desktop:dev": "bun run --cwd apps/desktop desktop:dev",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "desktop:prepare": "bun run --cwd apps/desktop desktop:prepare",
    "desktop:smoke": "bun run --cwd apps/desktop desktop:smoke",
    "desktop:check-version": "bun run --cwd apps/desktop desktop:check-version",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@trpc/client": "^11.24.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
