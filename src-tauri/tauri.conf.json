{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biomarker Tracker",
  "version": "../package.json",
  "identifier": "com.ai2070.biomarkertracker",
  "build": {
    "beforeDevCommand": { "script": "bun scripts/build-desktop.ts", "wait": true },
    "beforeBuildCommand": "bun scripts/build-desktop.ts",
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNjExRTEzOUM4RERCM0QKUldROTI0MmNFeDVoYkxSSlJxc2JIYitSKzFaeWdvU0VBcUtmTWxrdlQvWDdiQ0hMRGtkOFNhWUkK",
      "endpoints": ["https://github.com/ai-2070/biomarker-tracker/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bun"],
    "resources": { "app/": "app/" },
    "category": "Medical",
    "shortDescription": "Track your bloodwork and research it with AI agents",
    "longDescription": "Track your bloodwork over the years and research it with teams of AI agents on a live 3D map. Use zero-data-retention models from EU and US providers, or local models. Its server and saved data stay on your computer.",
    "copyright": "ai-2070",
    "homepage": "https://github.com/ai-2070/biomarker-tracker",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
