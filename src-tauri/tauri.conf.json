{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blacksite",
  "version": "../package.json",
  "identifier": "com.ai2070.blacksite",
  "build": {
    "beforeDevCommand": { "script": "bun scripts/build-desktop.ts", "wait": true },
    "beforeBuildCommand": "bun scripts/build-desktop.ts",
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNjExRTEzOUM4RERCM0QKUldROTI0MmNFeDVoYkxSSlJxc2JIYitSKzFaeWdvU0VBcUtmTWxrdlQvWDdiQ0hMRGtkOFNhWUkK",
      "endpoints": ["https://github.com/ai-2070/blacksite/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bun"],
    "resources": { "app/": "app/" },
    "category": "DeveloperTool",
    "shortDescription": "A local command center for AI agents",
    "longDescription": "Run AI agents and teams from one local workspace. Give each agent a role, a model and the tools it needs. Its server and saved state stay on your computer.",
    "copyright": "ai-2070",
    "homepage": "https://github.com/ai-2070/blacksite",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
