  "summary": "This is the number of red blood cells in a set volume of blood. Red cells carry oxygen from the lungs to the rest of the body.",
  "high": {
    "meaning": "A high red cell count usually goes with a high haemoglobin. It can come from dehydration, smoking or living at altitude. Some inherited conditions, such as thalassaemia trait, give many small red cells.",
    "commonCauses": [
      "Dehydration",
      "Smoking",
      "Living at high altitude",
      "Thalassaemia trait (many small cells)",
      "Bone marrow conditions (rare)"
    ]
  },
  "low": {
    "meaning": "A low red cell count usually goes with anaemia. Haemoglobin is the more useful number to look at.",
    "commonCauses": [
      "Iron, vitamin B12 or folate deficiency",
      "Blood loss",
      "Chronic illness or inflammation",
      "Pregnancy"
    ]
